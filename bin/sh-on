#!/bin/bash

# shell on a local dir
#
set -u -o pipefail -ex
umask 022

B=minbase
S=smurf
NC=
BIN=-b
F=
A=amd64
C="$(/bin/pwd)"

usage() {
	if [ $# -gt 0 ] ; then
		echo "$0: $*"
		echo "" >&2
		cat >&2
	else
		echo "$0: Simple shell (in a chroot)."
		echo ""
		cat
	fi <<END
Usage: $0 [options]
-a ARCH     architecture (default: $A)
-R          style of root (default: $B)
-n          drop and create new (default: re-use)
-d DIST     distribution (default: all)
END
	if test $# -gt 0 ; then
		echo "$*" >&2
	else
		echo 'Terminating...' >&2
	fi
	exit 1
}

TEMP="$(getopt -o 'a:R:d:n' -n "$(basename "$0")" -- "$@")" || usage "Invalid argument"

eval set -- "$TEMP"
unset TEMP
BIN=-b
MBIN=
BR=
while true ; do
    case "$1" in
	('-a')
	    shift; A=$1; shift ;;
	('-d')
	    shift; Z=$1; shift ;;
	('-h')
		usage ;;
	('-n')
	    shift; NEW=Y ;;
	('-R')
	    shift; B=$1; shift ;;
	('--')
		shift; break ;;
    *)
        usage "Unknown argument '$1'"
    esac
done

export LC_ALL=C.UTF-8

mk() {
	local X=$1
	local xd=$2

	cd "$C"

	local R="sudo --preserve-env=EMAIL,FULLNAME systemd-nspawn -E EMAIL -E FULLNAME --private-users=pick -D $X --bind-ro=$C:/$X/orig:rootidmap --bind=/srv/build/cache:/var/cache/apt/archives:rootidmap"

	# test -n "$NC" || $R eatmydata apt update
	# $R --chdir=/$Y eatmydata mk-build-deps -i -t 'apt-get -o Debug::pkgProblemResolver=yes --no-install-recommends --yes' src/debian/control

	$R --chdir=/src /bin/bash -i
}

mk2() {
	local xd=$1
	local xa=$2
	local DR=$D/$xd/$xa
	local X=$DM/$xd/$xa

	test -d $X && test -v NEW && sudo btrfs subvolume delete $X
	sudo mkdir -p $(dirname $X)
	test -d $X || sudo btrfs subvolume snapshot $DR $X

	sudo mkdir -p $X/src

	mk $X $xd
}

mk1() {
	local xd=$1
	local DD=$D/$xd

	mk2 $xd amd64
}

D=/srv/build/$B
DM=/srv/build/shell
if test -v Z ; then
	mk1 $Z
else
	mk1 testing
fi

